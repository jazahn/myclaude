# Template for ~/.claude/.credentials.env (machine-local, gitignored, chmod 600).
# Copy to .credentials.env and fill in real values on each machine:
#   cp ~/.claude/.credentials.env.example ~/.claude/.credentials.env
#   chmod 600 ~/.claude/.credentials.env
# Key names + purposes are documented in ~/.claude/credentials.md (committed).

# splunk (HUIT ATS Splunk API — FAS service account)
SPLUNK_API_KEY=

# github.com — PAT for github.com/harvard-huit and other SSO-protected orgs
GITHUB_PAT=

# github.huit.harvard.edu — PAT for github.huit.harvard.edu/HUIT repos
GITHUB_HUIT_PAT=
